# SQLite file. The Prisma CLI resolves this relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# mock uses the built-in sample catalog. rakuten calls Rakuten Advertising's Product Search API.
DEAL_PROVIDER="mock"

# --- Rakuten Advertising (US), not the Japan Ichiba API ---
# Create an app at https://developers.rakutenadvertising.com for the client id and secret.
# Account ID is your publisher SID. It is sent as the OAuth scope.
# See README for the full signup path. Leave these blank to stay on the sample catalog.
RAKUTEN_CLIENT_ID=""
RAKUTEN_CLIENT_SECRET=""
RAKUTEN_ACCOUNT_ID=""
# Optional. Paste a token from the developer portal to skip the token request.
RAKUTEN_ACCESS_TOKEN=""
# Password grant for older LinkShare apps. Leave blank to use client_credentials.
RAKUTEN_USERNAME=""
RAKUTEN_PASSWORD=""
# Token request auth header. Rakuten's own guide uses Bearer with the base64 key pair.
# Set to "basic" if your app was issued standard HTTP Basic credentials.
RAKUTEN_TOKEN_AUTH="bearer"
RAKUTEN_TOKEN_URL="https://api.rakutenmarketing.com/token"
RAKUTEN_SEARCH_URL="https://api.rakutenmarketing.com/productsearch/1.0"
# Optional advertiser id. Set this to limit results to one merchant, such as Rakuten.com itself.
RAKUTEN_MID=""
RAKUTEN_MAX="20"

# log prints the digest and saves it in the app. smtp and resend deliver it.
EMAIL_PROVIDER="log"
DIGEST_TO=""
EMAIL_FROM="Gift Hunter <hunter@localhost>"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

RESEND_API_KEY=""

# Single owner record. DIGEST_TO falls back to this address.
OWNER_EMAIL="owner@localhost"
OWNER_NAME="Alex"

# IANA timezone for "today" when deciding which occasions are due. UTC if unset.
OWNER_TIMEZONE="America/New_York"

# How many days ahead the schedule looks. An open-ended ad-hoc need is always due.
# A digest is sent once per occasion occurrence while that occurrence is inside this window.
DIGEST_LEAD_DAYS="14"

# Deals shown on a person's page. Lowest effective price first.
MAX_DEALS="5"
# Set to false to disable the in-process schedule. The desk button and /api/cron/upcoming still work.
SCHEDULER_ENABLED="true"
SCHEDULER_INTERVAL_MINUTES="360"
# Required for POST /api/cron/upcoming. The in-app button does not use this.
CRON_SECRET=""
