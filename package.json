{
  "name": "gift-hunter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4317 -H 0.0.0.0",
    "predev": "prisma generate && prisma db push && node --env-file=.env --import tsx prisma/seed.ts",
    "build": "prisma generate && next build",
    "start": "next start -p 4317 -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "pretest": "prisma generate",
    "db:push": "prisma db push",
    "db:upgrade": "prisma db push --accept-data-loss",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db prisma/dev.db-journal && prisma db push && node --env-file=.env --import tsx prisma/seed.ts --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
